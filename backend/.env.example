# Backend (FastAPI) settings. Every value here has a safe local default.

# "development" (default) or "production". Production refuses to start with unsafe defaults.
ENVIRONMENT=development

# Leave unset to use the local SQLite file (dev.db). Production must use Postgres.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Where uploaded datasets are stored as Parquet (one folder per workspace). Use a persistent volume in production.
DATA_DIR=./data

# Alerts & automations run in-process every minute. With several backend processes, enable it in exactly one.
SCHEDULER_ENABLED=true

# Upload limits (the browser checks the same size first).
# MAX_UPLOAD_BYTES=10485760
# MAX_UPLOAD_ROWS=1000000

# Chatwoot customer support (docs/chatwoot-integration.md). Leave CHATWOOT_BASE_URL empty to disable.
CHATWOOT_BASE_URL=
# Optional private address the backend uses to reach Chatwoot (defaults to CHATWOOT_BASE_URL)
CHATWOOT_API_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
# Public by design (the widget needs it)
CHATWOOT_WEBSITE_TOKEN=
# Secrets: keep them in your host's secret store, never in a committed file or the frontend
CHATWOOT_HMAC_TOKEN=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_HELP_CENTER_URL=
CHATWOOT_SHARE_EMAIL=true
