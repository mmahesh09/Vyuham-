# Backend (FastAPI) settings. Every value here has a safe local default.

# "development" (default) or "production". Production refuses to start with unsafe defaults.
ENVIRONMENT=development

# Leave unset to use the local SQLite file (dev.db). Production must use Postgres.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Where uploaded datasets are stored as Parquet (one folder per workspace). Use a persistent volume in production.
DATA_DIR=./data

# Background jobs (alerts, automations, reports) run on a Celery worker through Redis.
# Docker sets this. Leave it unset locally to run jobs in a thread inside the API instead.
# REDIS_URL=redis://localhost:6379/0
# WORKER_CONCURRENCY=2

# The no-Redis fallback: run due jobs in-process every minute (ignored when REDIS_URL is set).
SCHEDULER_ENABLED=true

# Upload limits (the browser checks the same size first).
# MAX_UPLOAD_BYTES=10485760
# MAX_UPLOAD_ROWS=1000000

# Reports. Signs short-lived print-page and download links (production needs a random 32+ chars).
# SIGNING_SECRET=change-me
# Where the report worker's browser opens the print page (the web app). Docker: http://frontend:3000
# PRINT_BASE_URL=http://localhost:3000
# PDF reports: forme (the web app renders them at PRINT_BASE_URL/internal/pdf, no browser) or chromium.
# PDF_RENDERER=forme
# PDF_CHROMIUM_FALLBACK=true
# Generated files: local (DATA_DIR/reports) or s3 (S3 / MinIO; pip install boto3)
# REPORT_STORAGE=local
# S3_BUCKET=  S3_ENDPOINT_URL=  S3_REGION=us-east-1  S3_ACCESS_KEY=  S3_SECRET_KEY=
# Local S3 for development: `pip install ministack && ministack` (or `docker compose --profile dev up s3`),
# create the bucket once, then: REPORT_STORAGE=s3 S3_BUCKET=vyuham-reports S3_ENDPOINT_URL=http://localhost:4566
# S3_ACCESS_KEY=test S3_SECRET_KEY=test. Test: S3_TEST_ENDPOINT=http://localhost:4566 pytest tests/test_storage_s3.py
# REPORT_RETENTION_DAYS=30
# REPORT_MAX_ROWS=1000000
# PDF reports locally need Chromium once: .venv/Scripts/playwright install chromium

# Per-user limits on expensive endpoints (SQL, Ask, uploads, exports, invites); counted in Redis when
# REDIS_URL is set, otherwise per process. On by default.
# RATE_LIMITS_ENABLED=true

# Check invite addresses before sending (self-hosted Reacher: docker run -p 8080:8080 reacherhq/backend;
# its host needs outbound port 25). Off when empty.
# REACHER_URL=http://localhost:8080
# REACHER_SECRET=

# Tracing (OpenTelemetry), off unless an endpoint is set. Works with any OTLP/HTTP backend.
# Self-hosted Traceway: clone github.com/tracewayapp/traceway, `docker compose -f docker-compose.sqlite.yml up`,
# create a project, then:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost/api/otel
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <project-token>"
