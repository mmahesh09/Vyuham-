# Copy to .env.prod on the server (never commit it) and fill in. Used by docker-compose.prod.yml.

# The API's domain; its DNS must point at this server. Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.com

# Managed Postgres, the SAME database the Vercel app uses (sign-in sessions are shared).
# postgres:// and postgresql:// URLs both work; keep sslmode=require if your provider gives it.
DATABASE_URL=postgresql://user:password@host:5432/vyuham?sslmode=require

# The web app's public address (Vercel): email links, and where PDF reports are rendered.
APP_URL=https://vyuham-six.vercel.app

# 32+ random characters, e.g.: openssl rand -base64 48
SIGNING_SECRET=
# Encrypts customers' saved database passwords. Generate once and keep it: losing it means every
# connection has to be re-entered. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTIONS_KEY=
# This server's public IP, shown in the "Connect a database" dialog for customers' firewalls.
PUBLIC_EGRESS_IP=

# Email through Resend (verify your sending domain there first). Empty = emails are only logged.
RESEND_API_KEY=
# AI SQL help and the AI Data Engineer. Leave empty to turn AI off (the app says so instead of guessing).
ANTHROPIC_API_KEY=
EMAIL_FROM=Vyuham <hello@example.com>

# Optional
# WORKER_CONCURRENCY=2
# PDF_RENDERER=forme
# PDF_CHROMIUM_FALLBACK=true
# REPORT_STORAGE=s3
# S3_BUCKET=  S3_ENDPOINT_URL=  S3_REGION=  S3_ACCESS_KEY=  S3_SECRET_KEY=
# REACHER_URL=  REACHER_SECRET=

# Observability: OpenTelemetry + Grafana (docker compose ... --profile observability). See docs/observability.md.
# Point the API, worker and beat at the Collector, and set the two secrets below (any long random strings).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_COLLECTOR_TOKEN=          # the Vercel app sends this as "Authorization=Bearer <token>" to https://API_DOMAIN/otel
# GRAFANA_ADMIN_PASSWORD=        # Grafana refuses to start without it (sign in at https://API_DOMAIN/grafana)
# GRAFANA_ADMIN_USER=admin
# OTEL_SAMPLE_PERCENT=10         # share of normal traces kept; errors and traces slower than 2 s are always kept
# TEMPO_RETENTION=336h  LOKI_RETENTION=336h  PROM_RETENTION=90d
# OTEL_LOGS_EXPORTER=otlp        # ship WARNING+ logs to Loki (set to none to keep logs local)
# For deploy/backup-data.sh: copy each backup to S3 as well (needs the aws CLI on the server).
# BACKUP_S3_URI=s3://your-bucket/vyuham-backups
