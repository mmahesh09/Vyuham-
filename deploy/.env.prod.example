# Copy to .env.prod on the server (never commit it) and fill in. Used by docker-compose.prod.yml.

# The API's domain; its DNS must point at this server. Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.com

# Managed Postgres, the SAME database the Vercel app uses (sign-in sessions are shared).
# postgres:// and postgresql:// URLs both work; keep sslmode=require if your provider gives it.
DATABASE_URL=postgresql://user:password@host:5432/vyuham?sslmode=require

# The web app's public address (Vercel): email links, and where PDF reports are rendered.
APP_URL=https://vyuham-six.vercel.app

# 32+ random characters, e.g.: openssl rand -base64 48
SIGNING_SECRET=

# Email through Resend (verify your sending domain there first). Empty = emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=Vyuham <hello@example.com>

# Optional
# WORKER_CONCURRENCY=2
# PDF_RENDERER=forme
# PDF_CHROMIUM_FALLBACK=true
# REPORT_STORAGE=s3
# S3_BUCKET=  S3_ENDPOINT_URL=  S3_REGION=  S3_ACCESS_KEY=  S3_SECRET_KEY=
# REACHER_URL=  REACHER_SECRET=
# OTEL_EXPORTER_OTLP_ENDPOINT=  OTEL_EXPORTER_OTLP_HEADERS=
# For deploy/backup-data.sh: copy each backup to S3 as well (needs the aws CLI on the server).
# BACKUP_S3_URI=s3://your-bucket/vyuham-backups
