BACKEND_URL=http://127.0.0.1:8000

# Public site URL, used for canonical links, Open Graph, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth. Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database shared with the backend. Unset = local SQLite at ../backend/dev.db
# DATABASE_URL=postgresql://app:app@localhost:5432/app

# Social sign-in (buttons explain they're not set up until these are filled in)
# Google: https://console.cloud.google.com/apis/credentials, redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: needs an Apple Developer account and HTTPS; redirect URI {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── GlitchTip error monitoring (docs/glitchtip-integration.md) ─────────────────────────
# Everything below is optional: with no DSN, nothing is sent and the app behaves as before.
# Project DSN from GlitchTip → Project settings → Client keys. Public by design (it can only send events).
NEXT_PUBLIC_GLITCHTIP_DSN=
# Optional separate DSN for server/edge errors; defaults to the one above.
GLITCHTIP_DSN=
# development | staging | production. Baked in at build time; set it per deployment.
NEXT_PUBLIC_APP_ENV=development
# Optional. Defaults to the git commit SHA (or VERCEL_GIT_COMMIT_SHA / GITHUB_SHA).
NEXT_PUBLIC_APP_RELEASE=
# Optional performance tracing, 0–1. Default 0 (errors only).
NEXT_PUBLIC_GLITCHTIP_TRACES_SAMPLE_RATE=0
# Send browser events through /sentry-tunnel to get past ad blockers.
GLITCHTIP_TUNNEL=false
# Enables /debug/glitchtip sample-error page (never in production).
GLITCHTIP_TEST_PAGE=false

# Source-map upload at BUILD time only. Keep SENTRY_AUTH_TOKEN in your CI/host secret store,
# never in a committed file and never with a NEXT_PUBLIC_ prefix.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
