BACKEND_URL=http://127.0.0.1:8000

# Public site URL, used for canonical links, Open Graph, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth. Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database shared with the backend. Unset = local SQLite at ../backend/dev.db
# DATABASE_URL=postgresql://app:app@localhost:5432/app

# Social sign-in (buttons explain they're not set up until these are filled in)
# Google: https://console.cloud.google.com/apis/credentials, redirect URI {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: needs an Apple Developer account and HTTPS; redirect URI {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
